<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xinl</groupId>
        <artifactId>easy-claw-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>easy-claw-agent-core</artifactId>
    <name>Easy Claw - Agent Core（引擎层）</name>
    <description>
        智能体引擎层：会话运行时、流事件、子智能体装配与派遣执行。
        承载原 com.xinl.easyclaw.agent 包的执行逻辑。

        本模块的边界纪律（务必守住，否则分层白拆）：
        - 允许依赖 spring-context / spring-beans（@Service、@Component 等装配注解）
        - 允许依赖 agentscope-core / agentscope-harness（Agent 运行时本体）
        - 禁止依赖 spring-boot-starter-web（无 Controller / 无 MVC）
        - 禁止依赖 spring-boot-starter-data-jpa（无 *Entity / 无 *Repository）
        凡需读取持久化数据处，一律通过 base 的倒置接口回调，方向恒为 api → agent-core → base。
    </description>

    <dependencies>
        <!-- 契约层：RoleProfile / ScenarioProfile / WorkflowParser 等倒置接口 -->
        <dependency>
            <groupId>com.xinl</groupId>
            <artifactId>easy-claw-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- AgentScope 运行时：HarnessAgent、Toolkit、MessageBus -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>

        <!-- 仅 spring-context：装配注解可用，但不引入 Web / JPA -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- @PostConstruct / @PreDestroy -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!-- 流式事件 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
