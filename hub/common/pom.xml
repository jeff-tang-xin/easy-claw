<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xinl</groupId>
        <artifactId>easy-claw-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>easy-claw-hub-common</artifactId>
    <name>Easy Claw - Hub Common</name>
    <description>hub 服务端公共层：业务异常（ApiException）、实体基座（BaseEntity）、审计维度常量（AuditModule）、通用工具（Slugger）。仅被 hub/server 依赖；不放业务逻辑。</description>

    <dependencies>
        <!-- ApiException 携带契约层 ErrorCode -->
        <dependency>
            <groupId>com.xinl</groupId>
            <artifactId>easy-claw-hub-contract</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ApiException 的 HttpStatus；仅类型引用，不带 web 运行时 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- BaseEntity 的 JPA 注解（@MappedSuperclass/@PrePersist 等）；仅 API，不带实现 -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
